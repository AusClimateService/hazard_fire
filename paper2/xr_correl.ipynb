    "FT=dfe95\n",
    "# compute seasonal diagnostics for subsequent use\n",
    "mask=FT.notnull()\n",
    "days = xr.where(mask, 1, np.nan)\n",
    "tot_days=(days.groupby('time.season').sum('time')+d95*0).load()\n",
    "seasonal_clim = (FT.groupby('time.season').mean('time')).load()\n"
   ]
